# The static site needs no packages at all: index.html is self-contained and the only entries in
# package.json are the Electron desktop build tools. Render auto-runs `npm install` for any repo
# with a package.json, which without this would download Electron (~250 MB) on every deploy.
#
# There are no runtime dependencies, so omitting dev makes that install a no-op.
# The desktop workflow overrides this with `npm install --include=dev`.
omit=dev
