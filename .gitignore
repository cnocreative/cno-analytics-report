# ---- REAL CLIENT DATA — never commit ----
resources/sample_accounts.csv
resources/sample_content.csv
*_real.csv
accounts.csv
content.csv

# ---- Internal working docs (client names, strategy, contacts) ----
00_SYSTEM_OUTLINE.md
02_INDUSTRY_BENCHMARKS.md
03_OPEN_QUESTIONS.md
04_RESEARCH_NOTES.md
05_PROCESS_DOC.md

# local dev helper, not needed for deployment
serve.ps1
.claude/*
# ...except shared skills, which are how CNO staff run the monthly process. Git will not look
# inside an excluded directory, so the contents are excluded and the skills path re-included.
!.claude/skills/
!.claude/skills/**

# The client name list the privacy scan greps for. Local only: the names are the thing being
# protected, so committing the list to a public repository would defeat the scan it feeds.
client-names.txt
_seed.html
_verify_*

# desktop app build (Electron) — installers are produced by CI, not committed
node_modules/
dist-desktop/
package-lock.json

# local OAuth service credentials
.env
.env.*
!.env.example
sync-service/.env

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# Python bytecode from the automation scripts
__pycache__/
*.pyc
