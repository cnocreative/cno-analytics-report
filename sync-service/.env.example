PORT=10000
PUBLIC_BASE_URL=http://localhost:10000

# Comma-separated list of report origins allowed to call this service.
REPORT_ORIGIN=http://localhost:5601

# Optional. Without it the service stores connections in a local JSON file (see SYNC_DATA_DIR),
# which is fine for finishing setup and testing a real sign-in but is NOT durable on a container
# filesystem. Set a persistent Postgres URL before connecting live client accounts.
DATABASE_URL=
SYNC_DATA_DIR=

# Generate all three as long random values. TOKEN_ENCRYPTION_KEY must be 32 bytes, base64 encoded.
CNO_ADMIN_TOKEN=replace-with-a-long-random-admin-login
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SYNC_CRON_SECRET=replace-with-a-third-long-random-secret

# Provider apps. Values stay in the server environment and are never sent to the report.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_API_VERSION=v25.0
META_SCOPES=pages_show_list,pages_read_engagement,read_insights,instagram_basic,instagram_manage_insights,ads_read

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.list

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202607
LINKEDIN_SCOPES=rw_organization_admin,r_organization_social
